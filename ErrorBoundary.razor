@using Microsoft.AspNetCore.Components.Web
@inherits ErrorBoundaryBase
@inject NavigationManager NavigationManager

<div class="error-boundary-container">
    @if (CurrentException is not null)
    {
        <div class="container-fluid py-5">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="card border-danger">
                        <div class="card-header bg-danger text-white">
                            <h4 class="mb-0">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                Prišlo je do napake
                            </h4>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-danger">
                                <h5>Opis napake:</h5>
                                <p class="mb-0">@GetUserFriendlyError(CurrentException)</p>
                            </div>
                            
                            @if (ShowDetails)
                            {
                                <details class="mt-3">
                                    <summary class="btn btn-outline-secondary btn-sm">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Tehnične podrobnosti
                                    </summary>
                                    <div class="mt-2 p-3 bg-light rounded">
                                        <pre class="text-muted small mb-0">@CurrentException.ToString()</pre>
                                    </div>
                                </details>
                            }
                            
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                                <button class="btn btn-outline-secondary" @onclick="() => ShowDetails = !ShowDetails">
                                    <i class="fas fa-cog me-1"></i>
                                    @(ShowDetails ? "Skrij" : "Prikaži") podrobnosti
                                </button>
                                <button class="btn btn-primary" @onclick="Recover">
                                    <i class="fas fa-refresh me-1"></i>
                                    Poskusi znova
                                </button>
                                <button class="btn btn-success" @@onclick="() => NavigationManager.NavigateTo(\"/\", forceLoad: true)">
                                    <i class="fas fa-home me-1"></i>
                                    Domača stran
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        @ChildContent
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    
    private bool ShowDetails { get; set; } = false;

    protected override async Task OnErrorAsync(Exception exception)

    {

        // Zabeleži napako (za zdaj kar v konzolo)

        Console.Error.WriteLine($"Error Boundary caught: {exception}");

        // Če imaš logger service, bi uporabil nekaj takega:

        // logger.LogError(exception, "Unhandled exception caught by ErrorBoundary");

        // Ker metoda mora biti async, vrnemo CompletedTask

        await Task.CompletedTask;

    }

    private string GetUserFriendlyError(Exception exception)
    {
        return exception switch
        {
            HttpRequestException httpEx when httpEx.Message.Contains("7253") => 
                "Ne morem se povezati z API strežnikom. Preverite, ali je API zagnan na portu 7253.",
            
            HttpRequestException => 
                "Težava s povezavo do strežnika. Preverite internetno povezavo.",
            
            TaskCanceledException => 
                "Zahteva je bila prekinjena zaradi časovne omejitve.",
            
            InvalidOperationException opEx when opEx.Message.Contains("routes are ambiguous") =>
                "Routing napaka: Več strani ima isto pot. Preverite @page direktive.",
            
            InvalidOperationException opEx when opEx.Message.Contains("Chart") =>
                "Napaka pri nalaganju grafov. Preverite ali je charts.js naložen.",
            
            UnauthorizedAccessException => 
                "Nimate dovoljenja za dostop do te vsebine.",
            
            ArgumentException argEx => 
                $"Napačni podatki: {argEx.Message}",
            
            _ => 
                "Prišlo je do nepričakovane napake. Poskusite znova ali se obrnite na podporo."
        };
    }
}

<style>
    .error-boundary-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
        display: flex;
        align-items: center;
    }

    .card {
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    details summary {
        cursor: pointer;
        user-select: none;
    }

    details summary::-webkit-details-marker {
        display: none;
    }

    details[open] summary::before {
        content: "▼ ";
    }

    details summary::before {
        content: "▶ ";
        margin-right: 0.5rem;
    }

    pre {
        max-height: 300px;
        overflow-y: auto;
        font-size: 0.75rem;
        line-height: 1.4;
        white-space: pre-wrap;
        word-break: break-word;
    }

    @@media (max-width: 768px) {
        .container-fluid {
            padding: 1rem;
        }
        
        .d-grid.gap-2.d-md-flex {
            flex-direction: column;
        }
    }
</style>