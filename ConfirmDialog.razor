@if (IsVisible)
{
    <div class="modal fade show" style="display: block;" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered @SizeClass">
            <div class="modal-content">
                <div class="modal-header @HeaderClass">
                    <h5 class="modal-title d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(Icon))
                        {
                            <i class="@Icon me-2"></i>
                        }
                        @Title
                    </h5>
                    @if (ShowCloseButton)
                    {
                        <button type="button" class="btn-close @(Type == DialogType.Danger ? "btn-close-white" : "")"
                                @onclick="Cancel"></button>
                    }
                </div>

                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(Message))
                    {
                        <p class="mb-3">@Message</p>
                    }

                    @if (ChildContent != null)
                    {
                        @ChildContent
                    }

                    @if (ShowDetails && !string.IsNullOrEmpty(Details))
                    {
                        <div class="alert alert-light mt-3">
                            <details>
                                <summary class="cursor-pointer">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Več podrobnosti
                                </summary>
                                <div class="mt-2">
                                    @Details
                                </div>
                            </details>
                        </div>
                    }

                    @if (Type == DialogType.Danger && ShowWarningText)
                    {
                        <div class="alert alert-warning d-flex align-items-center mt-3">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <div>
                                <strong>Opozorilo:</strong> Te akcije ni mogoče razveljaviti!
                            </div>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    @if (ShowCancelButton)
                    {
                        <button type="button" class="btn btn-secondary" @onclick="Cancel" disabled="@IsProcessing">
                            <i class="fas fa-times me-1"></i>
                            @CancelText
                        </button>
                    }

                    @if (Type == DialogType.Input && !string.IsNullOrEmpty(SecondaryActionText))
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="SecondaryAction" disabled="@IsProcessing">
                            @SecondaryActionText
                        </button>
                    }

                    <button type="button" class="btn @ConfirmButtonClass" @onclick="Confirm" disabled="@(IsProcessing || !IsConfirmEnabled)">
                        @if (IsProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        else if (!string.IsNullOrEmpty(ConfirmIcon))
                        {
                            <i class="@ConfirmIcon me-1"></i>
                        }
                        @ConfirmText
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public bool IsVisible { get; set; } = false;
    [Parameter] public string Title { get; set; } = "Potrditev";
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public string Details { get; set; } = string.Empty;
    [Parameter] public string ConfirmText { get; set; } = "Potrdi";
    [Parameter] public string CancelText { get; set; } = "Prekliči";
    [Parameter] public string SecondaryActionText { get; set; } = string.Empty;
    [Parameter] public DialogType Type { get; set; } = DialogType.Confirmation;
    [Parameter] public DialogSize Size { get; set; } = DialogSize.Small;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public string ConfirmIcon { get; set; } = string.Empty;
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [Parameter] public bool ShowCancelButton { get; set; } = true;
    [Parameter] public bool ShowWarningText { get; set; } = true;
    [Parameter] public bool ShowDetails { get; set; } = false;
    [Parameter] public bool IsProcessing { get; set; } = false;
    [Parameter] public bool IsConfirmEnabled { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnSecondaryAction { get; set; }
    [Parameter] public Func<Task<bool>>? OnConfirmAsync { get; set; }

    public enum DialogType
    {
        Confirmation,
        Warning,
        Danger,
        Info,
        Input
    }

    public enum DialogSize
    {
        Small,
        Medium,
        Large,
        ExtraLarge
    }

    private string SizeClass => Size switch
    {
        DialogSize.Medium => "modal-lg",
        DialogSize.Large => "modal-xl",
        DialogSize.ExtraLarge => "modal-fullscreen-lg-down",
        _ => ""
    };

    private string HeaderClass => Type switch
    {
        DialogType.Danger => "bg-danger text-white",
        DialogType.Warning => "bg-warning text-dark",
        DialogType.Info => "bg-info text-white",
        _ => "bg-light"
    };

    private string ConfirmButtonClass => Type switch
    {
        DialogType.Danger => "btn-danger",
        DialogType.Warning => "btn-warning",
        DialogType.Info => "btn-info",
        _ => "btn-primary"
    };

    protected override void OnParametersSet()
    {
        // Set default icons based on type
        if (string.IsNullOrEmpty(Icon))
        {
            Icon = Type switch
            {
                DialogType.Danger => "fas fa-exclamation-triangle",
                DialogType.Warning => "fas fa-exclamation-circle",
                DialogType.Info => "fas fa-info-circle",
                DialogType.Input => "fas fa-edit",
                _ => "fas fa-question-circle"
            };
        }

        if (string.IsNullOrEmpty(ConfirmIcon))
        {
            ConfirmIcon = Type switch
            {
                DialogType.Danger => "fas fa-trash",
                DialogType.Warning => "fas fa-exclamation",
                DialogType.Info => "fas fa-check",
                DialogType.Input => "fas fa-save",
                _ => "fas fa-check"
            };
        }
    }

    private async Task Confirm()
    {
        if (OnConfirmAsync != null)
        {
            var result = await OnConfirmAsync();
            if (result)
            {
                await OnConfirm.InvokeAsync();
                Hide();
            }
        }
        else
        {
            await OnConfirm.InvokeAsync();
            Hide();
        }
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
        Hide();
    }

    private async Task SecondaryAction()
    {
        await OnSecondaryAction.InvokeAsync();
    }

    public void Show()
    {
        IsVisible = true;
        StateHasChanged();
    }

    public void Hide()
    {
        IsVisible = false;
        IsProcessing = false;
        StateHasChanged();
    }

    public void SetProcessing(bool processing)
    {
        IsProcessing = processing;
        StateHasChanged();
    }
}

<style>
    .modal-dialog-centered {
        min-height: calc(100vh - 1rem);
        display: flex;
        align-items: center;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    .modal-content {
        border-radius: 0.75rem;
        border: none;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    }

    .modal-header {
        border-bottom: 1px solid #e5e7eb;
        border-radius: 0.75rem 0.75rem 0 0;
        padding: 1.5rem;
    }

    .modal-body {
        padding: 1.5rem;
        line-height: 1.6;
    }

    .modal-footer {
        border-top: 1px solid #e5e7eb;
        border-radius: 0 0 0.75rem 0.75rem;
        padding: 1.5rem;
        background-color: #f8fafc;
    }

    .alert {
        border-radius: 0.5rem;
        border: none;
        padding: 1rem;
    }

    .alert-light {
        background-color: #f8f9fa;
        color: #495057;
        border-left: 4px solid #6c757d;
    }

    .alert-warning {
        background-color: #fff3cd;
        color: #856404;
        border-left: 4px solid #ffc107;
    }

    details summary {
        outline: none;
        user-select: none;
    }

        details summary::-webkit-details-marker {
            display: none;
        }

    details[open] summary::before {
        transform: rotate(90deg);
    }

    details summary::before {
        content: '▶';
        margin-right: 0.5rem;
        transition: transform 0.2s ease;
    }

    /* Dark mode support */
    @@media (prefers-color-scheme: dark) {
        .modal-content

    {
        background-color: #374151;
        color: #f9fafb;
    }

    .modal-header.bg-light {
        background-color: #4b5563 !important;
        color: #f9fafb !important;
    }

    .modal-footer {
        background-color: #4b5563;
    }

    .alert-light {
        background-color: #4b5563;
        color: #d1d5db;
        border-left-color: #9ca3af;
    }

    .alert-warning {
        background-color: #45281a;
        color: #fbbf24;
    }

    }

    /* Responsive adjustments */
    @@media (max-width: 576px) {
        .modal-dialog

    {
        margin: 0.5rem;
    }

    .modal-header,
    .modal-body,
    .modal-footer {
        padding: 1rem;
    }

    .modal-footer {
        flex-direction: column;
    }

        .modal-footer .btn {
            width: 100%;
            margin-bottom: 0.5rem;
        }

            .modal-footer .btn:last-child {
                margin-bottom: 0;
            }

    }

    /* Animation improvements */
    .modal.fade .modal-dialog {
        transition: transform 0.3s ease-out;
        transform: translate(0, -50px);
    }

    .modal.show .modal-dialog {
        transform: none;
    }

    /* Button focus states */
    .btn:focus {
        outline: 2px solid transparent;
        outline-offset: 2px;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.5);
    }

    .btn-danger:focus {
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.5);
    }

    .btn-warning:focus {
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.5);
    }

    /* High contrast mode */
    @@media (prefers-contrast: high) {
        .modal-content

    {
        border: 2px solid currentColor;
    }

    .btn {
        border: 2px solid currentColor;
    }

    }
</style>