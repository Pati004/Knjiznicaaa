@if (TotalPages > 1)
{
    <nav aria-label="Navigacija po straneh">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <!-- Items per page selector -->
            <div class="d-flex align-items-center">
                <label for="itemsPerPage" class="form-label me-2 mb-0">Prikaži:</label>
                <select id="itemsPerPage" class="form-select form-select-sm" style="width: auto;" 
                        value="@PageSize" @onchange="OnPageSizeChange">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <span class="text-muted ms-2">na stran</span>
            </div>

            <!-- Page info -->
            <div class="text-muted">
                Prikazuje @StartItem - @EndItem od @TotalItems rezultatov
            </div>
        </div>

        <!-- Pagination controls -->
        <ul class="pagination pagination-sm justify-content-center mb-0">
            <!-- First page -->
            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => GoToPage(1)" disabled="@(CurrentPage == 1)"
                        title="Prva stran">
                    <i class="fas fa-angle-double-left"></i>
                </button>
            </li>

            <!-- Previous page -->
            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => GoToPage(CurrentPage - 1)" disabled="@(CurrentPage == 1)"
                        title="Prejšnja stran">
                    <i class="fas fa-angle-left"></i>
                </button>
            </li>

            <!-- Page numbers -->
            @foreach (var page in GetVisiblePages())
            {
                <li class="page-item @(page == CurrentPage ? "active" : "")">
                    @if (page == -1)
                    {
                        <span class="page-link">...</span>
                    }
                    else
                    {
                        <button class="page-link" @onclick="() => GoToPage(page)">@(page)</button>
                    }
                </li>
            }

            <!-- Next page -->
            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                <button class="page-link" @onclick="() => GoToPage(CurrentPage + 1)" disabled="@(CurrentPage == TotalPages)"
                        title="Naslednja stran">
                    <i class="fas fa-angle-right"></i>
                </button>
            </li>

            <!-- Last page -->
            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                <button class="page-link" @onclick="() => GoToPage(TotalPages)" disabled="@(CurrentPage == TotalPages)"
                        title="Zadnja stran">
                    <i class="fas fa-angle-double-right"></i>
                </button>
            </li>
        </ul>

        <!-- Quick jump to page -->
        @if (ShowQuickJump && TotalPages > 10)
        {
            <div class="mt-3 text-center">
                <div class="d-inline-flex align-items-center">
                    <span class="text-muted me-2">Pojdi na stran:</span>
                    <input type="number" class="form-control form-control-sm" style="width: 80px;" 
                           min="1" max="@TotalPages" @bind="jumpToPage" @onkeypress="OnJumpKeyPress" />
                    <button class="btn btn-sm btn-outline-primary ms-2" @onclick="JumpToPage">
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        }
    </nav>
}

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int TotalItems { get; set; } = 0;
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }
    [Parameter] public EventCallback<int> OnPageSizeChanged { get; set; }
    [Parameter] public bool ShowQuickJump { get; set; } = true;
    [Parameter] public int MaxVisiblePages { get; set; } = 7;

    private int jumpToPage = 1;
    
    private int TotalPages => (int)Math.Ceiling((double)TotalItems / PageSize);
    private int StartItem => TotalItems == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
    private int EndItem => Math.Min(CurrentPage * PageSize, TotalItems);

    protected override void OnParametersSet()
    {
        jumpToPage = CurrentPage;
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages && page != CurrentPage)
        {
            await OnPageChanged.InvokeAsync(page);
        }
    }

    private async Task OnPageSizeChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newPageSize))
        {
            await OnPageSizeChanged.InvokeAsync(newPageSize);
        }
    }

    private async Task JumpToPage()
    {
        if (jumpToPage >= 1 && jumpToPage <= TotalPages)
        {
            await GoToPage(jumpToPage);
        }
    }

    private async Task OnJumpKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await JumpToPage();
        }
    }

    private List<int> GetVisiblePages()
    {
        var pages = new List<int>();
        
        if (TotalPages <= MaxVisiblePages)
        {
            // Show all pages
            for (int i = 1; i <= TotalPages; i++)
            {
                pages.Add(i);
            }
        }
        else
        {
            // Calculate start and end of visible range
            int start = Math.Max(1, CurrentPage - MaxVisiblePages / 2);
            int end = Math.Min(TotalPages, start + MaxVisiblePages - 1);
            
            // Adjust start if we're near the end
            if (end == TotalPages)
            {
                start = Math.Max(1, end - MaxVisiblePages + 1);
            }
            
            // Always show first page
            if (start > 1)
            {
                pages.Add(1);
                if (start > 2)
                {
                    pages.Add(-1); // Ellipsis
                }
            }
            
            // Show visible range
            for (int i = start; i <= end; i++)
            {
                pages.Add(i);
            }
            
            // Always show last page
            if (end < TotalPages)
            {
                if (end < TotalPages - 1)
                {
                    pages.Add(-1); // Ellipsis
                }
                pages.Add(TotalPages);
            }
        }
        
        return pages;
    }
}

<style>
    .pagination {
        margin-bottom: 0;
    }

    .page-link {
        border: 1px solid #dee2e6;
        color: #3b82f6;
        background-color: #fff;
        transition: all 0.2s ease-in-out;
    }

        .page-link:hover {
            background-color: #e7f3ff;
            border-color: #3b82f6;
            color: #1e40af;
            transform: translateY(-1px);
        }

        .page-link:focus {
            box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25);
        }

    .page-item.active .page-link {
        background-color: #3b82f6;
        border-color: #3b82f6;
        color: #fff;
        font-weight: 600;
    }

    .page-item.disabled .page-link {
        color: #6c757d;
        background-color: #fff;
        border-color: #dee2e6;
        cursor: not-allowed;
    }

        .page-item.disabled .page-link:hover {
            transform: none;
        }

    /* Compact pagination for mobile */
    @@media (max-width: 576px) {
        .pagination {
            font-size: 0.875rem;
        }

        .page-link {
            padding: 0.25rem 0.5rem;
        }

        .d-flex.justify-content-between {
            flex-direction: column;
            gap: 1rem;
        }

        .d-flex.justify-content-between > div {
            text-align: center;
        }
    }

    /* Dark mode support */
    @@media (prefers-color-scheme: dark) {
        .page-link {
            background-color: #374151;
            border-color: #4b5563;
            color: #60a5fa;
        }

            .page-link:hover {
                background-color: #4b5563;
                border-color: #60a5fa;
            }

        .page-item.active .page-link {
            background-color: #3b82f6;
            border-color: #3b82f6;
        }

        .page-item.disabled .page-link {
            background-color: #374151;
            border-color: #4b5563;
            color: #6b7280;
        }
    }
</style>